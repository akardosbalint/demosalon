# Copy to .env (or .env.local for a machine-specific override — Next.js
# loads that with higher priority and it's gitignored) and fill in real
# values. Nothing below is a working credential.

# Postgres connection string (Supabase Supavisor session-mode pooler, or
# any Postgres 15+ instance — the schema relies on btree_gist for the
# double-booking exclusion constraint).
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Signs the admin session JWT (src/lib/session.ts). Generate with e.g.
# `openssl rand -base64 32`.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Seeds the one admin account `prisma/seed.ts` creates.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="replace-with-a-real-password"

# Public site origin — used to build the self-service manage-booking link
# (/foglalas/kezeles/[token]) inside confirmation/reminder emails and SMS.
NEXT_PUBLIC_APP_URL="https://your-domain.example"

# --- Email (Resend) ---------------------------------------------------
# Optional. Without RESEND_API_KEY, src/lib/notifications.ts logs the
# email instead of sending it — booking still succeeds either way.
RESEND_API_KEY=""
RESEND_FROM_EMAIL="Bloom Szépségszalon <booking@your-domain.example>"

# --- SMS (Twilio) -------------------------------------------------------
# Optional, same fallback-to-log behavior as email. All three must be set
# together for SMS to actually send.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# --- Reminder cron --------------------------------------------------
# Required for GET /api/cron/reminders to run — the route returns 500
# until this is set, and 401 on any request whose Authorization header
# isn't exactly "Bearer <this value>". See README "Emlékeztető cron".
CRON_SECRET="replace-with-a-random-secret"
