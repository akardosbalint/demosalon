// Beauty salon booking system — core data model.
//
// The double-booking guarantee lives in the database, not in application code:
// see prisma/migrations/.../migration.sql for the `EXCLUDE USING gist`
// constraint on booking_segments(employee_id, tstzrange(start_time, end_time)).
// That constraint has no representation in this DSL, so schema drift checks
// on this table must be reviewed by hand — see README.md "Schema drift" note.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  name         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("admin_users")
}

model Employee {
  id              String   @id @default(cuid())
  name            String
  bio             String
  photoUrl        String?  @map("photo_url")
  experienceYears Int      @default(0) @map("experience_years")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employeeServices EmployeeService[]
  bookingSegments  BookingSegment[]
  availability     EmployeeAvailability[]

  @@map("employees")
}

// The employee's recurring weekly working hours. Absence of a row for a
// given (employee, dayOfWeek) means "not configured for that day" — how
// that's interpreted lives in src/lib/booking.ts: an employee with zero
// rows at all is treated as available every day within the salon's
// default business hours (legacy/unconfigured default, and what every
// test employee gets), while an employee with at least one row is
// treated as fully scheduled — any weekday without a row for them is a
// day off. One-off exceptions (a single day's vacation/sick leave) are
// out of scope for this model; see README "Ismert korlátok".
model EmployeeAvailability {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  // 0 = vasárnap .. 6 = szombat (JS Date#getDay()/getUTCDay() konvenció).
  dayOfWeek  Int      @map("day_of_week")
  startHour  Int      @map("start_hour")
  endHour    Int      @map("end_hour")

  @@unique([employeeId, dayOfWeek])
  @@map("employee_availability")
}

model Service {
  id                   String   @id @default(cuid())
  name                 String
  slug                 String   @unique
  description          String
  durationMinutes      Int      @map("duration_minutes")
  // Time between the end of this service and the start of the next one in a
  // combo during which the employee is free to serve someone else (e.g. hair
  // dye developing time). 0 for services with no dependency.
  processingTimeMinutes Int     @default(0) @map("processing_time_minutes")
  // Whole-currency-unit price (HUF has no minor unit in everyday use).
  price                Int
  active               Boolean  @default(true)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  employeeServices EmployeeService[]
  bookingSegments  BookingSegment[]
  comboItems       ServiceComboItem[]

  @@map("services")
}

model EmployeeService {
  employeeId String @map("employee_id")
  serviceId  String @map("service_id")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([employeeId, serviceId])
  @@index([serviceId])
  @@map("employee_services")
}

model ServiceCombo {
  id          String  @id @default(cuid())
  name        String
  description String?
  isFeatured  Boolean @default(false) @map("is_featured")
  // Editorial display-order hint only (admin-curated) — NOT shown to guests
  // as a percentage anymore. The "X%-a ezt választja" badge is computed live
  // from real booking history (src/lib/stats.ts) so it's never a made-up
  // number; this field just breaks ties in list ordering.
  popularityScore Int      @default(0) @map("popularity_score")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  items ServiceComboItem[]

  @@map("service_combos")
}

model ServiceComboItem {
  comboId       String @map("combo_id")
  serviceId     String @map("service_id")
  sequenceOrder Int    @map("sequence_order")

  combo   ServiceCombo @relation(fields: [comboId], references: [id], onDelete: Cascade)
  service Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([comboId, serviceId])
  @@index([serviceId])
  @@map("service_combo_items")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("booking_status")
}

model Booking {
  id             String        @id @default(cuid())
  customerName   String        @map("customer_name")
  // Optional: guest self-booking always collects it (needed for the
  // confirmation + self-service manage link), but admin-entered phone
  // bookings shouldn't be forced to invent an address for a walk-in/phone
  // customer who never gave one.
  customerEmail  String?       @map("customer_email")
  customerPhone  String        @map("customer_phone")
  status         BookingStatus @default(CONFIRMED)
  notes          String?
  cancelledAt    DateTime?     @map("cancelled_at") @db.Timestamptz(3)
  reminderSentAt DateTime?     @map("reminder_sent_at") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // Unguessable, unique per booking — the self-service "manage my booking"
  // link (/foglalas/kezeles/[token]) is looked up by this, not by the
  // primary key, so it can't be guessed by iterating booking IDs.
  manageToken String @unique @default(cuid()) @map("manage_token")

  segments BookingSegment[]

  @@index([customerEmail])
  @@map("bookings")
}

// One row per (employee, service, time range) unit of work. A single Booking
// is made of 1+ segments — one per service, possibly across different
// employees and non-contiguous times when there's processing-time slack in
// between. The employee_id + time-range overlap check that makes double
// booking impossible at the database level is defined directly on this
// table's columns (see migration.sql), which is why segments are the unit
// of scheduling truth rather than the parent Booking.
model BookingSegment {
  id            String   @id @default(cuid())
  bookingId     String   @map("booking_id")
  employeeId    String   @map("employee_id")
  serviceId     String   @map("service_id")
  startTime     DateTime @map("start_time") @db.Timestamptz(3)
  endTime       DateTime @map("end_time") @db.Timestamptz(3)
  sequenceOrder Int      @map("sequence_order")

  booking  Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
  service  Service  @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_segments")
}
